{
  "name": "vortex-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Vortex Distillery ERP - Lean MVP (PRD v2), hosted on Netlify",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "netlify dev",
    "dev:web": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@neondatabase/serverless": "1.2.0",
    "@netlify/blobs": "11.1.3",
    "@netlify/database": "2.0.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@netlify/functions": "6.0.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "netlify-cli": "27.11.2",
    "tailwindcss": "4.1.17",
    "tsx": "4.19.2",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  }
}
