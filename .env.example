# Postgres. On Netlify, enabling Netlify DB sets NETLIFY_DATABASE_URL automatically.
# Leave both unset locally to use the embedded PGlite database in .data/pglite.
# DATABASE_URL=postgres://user:password@host/db?sslmode=require

# First Owner account, created once by the initial migration. The Owner must change the PIN at first sign-in.
OWNER_NAME=Owner
OWNER_PHONE=0700000001
OWNER_INITIAL_PIN=1234
